<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="10" styleClass="page-view" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pusula.desktop.controller.ServiceTicketController">
   <padding>
      <Insets bottom="8.0" left="0.0" right="0.0" top="8.0" />
   </padding>
   <children>
      <FlowPane alignment="CENTER_LEFT" hgap="10" vgap="8" styleClass="page-toolbar">
         <TextField fx:id="txtSearch" prefWidth="256" promptText="Müşteri, iş, teknisyen veya fiş no" accessibleText="Servis işlerinde ara"/>
         <ToggleButton text="Tarih ve sıralama" fx:id="moreFilters" styleClass="filter-toggle"/>
         <Label fx:id="resultCountLabel" styleClass="page-subtitle"/>
         <Button fx:id="btnBulkAssign" managed="false" visible="false" onAction="#handleBulkAssign" text="Toplu atama" styleClass="btn-secondary"/>
         <Button onAction="#handleCreateTicket" styleClass="btn-primary" text="Yeni servis işi"/>
         <Button onAction="#handleRefresh" styleClass="btn-secondary" text="%btn.refresh"/>
      </FlowPane>
      <FlowPane alignment="CENTER_LEFT" hgap="12" vgap="8" visible="${moreFilters.selected}" managed="${moreFilters.selected}" styleClass="filter-bar">
         <VBox spacing="4" styleClass="filter-control-group">
            <Label text="Randevu tarihi" styleClass="field-label"/>
            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="date-range-group">
               <DatePicker fx:id="startDatePicker" prefWidth="145" promptText="Başlangıç"/>
               <Label text="–" styleClass="date-range-separator"/>
               <DatePicker fx:id="endDatePicker" prefWidth="145" promptText="Bitiş"/>
            </HBox>
         </VBox>
         <VBox spacing="4" styleClass="filter-control-group">
            <Label text="Sıralama" styleClass="field-label"/>
            <ComboBox fx:id="sortComboBox" prefWidth="200" promptText="Sıralama"/>
         </VBox>
         <Button onAction="#handleClearFilters" text="Filtreleri temizle" styleClass="btn-secondary"/>
      </FlowPane>
      <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="filter-scroll">
         <content><HBox fx:id="filterChipContainer" spacing="5" styleClass="filter-chip-container"/></content>
      </ScrollPane>
      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <ListView fx:id="ticketsListView" styleClass="tickets-list" VBox.vgrow="ALWAYS" />
            <VBox fx:id="emptyStateBox" alignment="CENTER" managed="false" spacing="8.0" styleClass="empty-state" visible="false">
               <children>
                  <Label styleClass="empty-state-title" text="Bu filtrede sonuç yok" />
                  <Label styleClass="empty-state-subtitle" text="Başka bir durum seçebilir veya yeni servis işi açabilirsiniz." />
               </children>
            </VBox>
            <StackPane fx:id="loadingOverlay" managed="false" styleClass="loading-overlay" visible="false">
               <children>
                  <ProgressIndicator />
               </children>
            </StackPane>
         </children>
      </StackPane>
   </children>
</VBox>
