<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pusula.desktop.controller.BusinessAssetController">
    <padding>
        <Insets bottom="8.0" top="8.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="page-header-title" text="Takımlar / Demirbaşlar" />
            <Label fx:id="assetResultLabel" styleClass="page-subtitle" text="" />
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="page-header-actions">
            <TextField fx:id="assetSearchField" prefWidth="220.0" promptText="Ad, seri no, konum veya zimmet ara..." />
            <Button onAction="#handleClearAssetSearch" styleClass="btn-secondary" text="Temizle" />
            <Button fx:id="exportAssetButton" onAction="#handleExportAssetsPdf" styleClass="btn-export" text="PDF Kaydet" />
            <Button fx:id="addAssetButton" onAction="#handleAddAsset" styleClass="btn-primary" text="Yeni Kayıt" />
            <Button onAction="#handleRefreshAssets" styleClass="btn-secondary" text="Yenile" />
        </HBox>
    </HBox>

    <VBox spacing="0" styleClass="card-container" VBox.vgrow="ALWAYS">
        <TableView fx:id="assetTable" styleClass="premium-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colAssetName" minWidth="140.0" prefWidth="170.0" text="Takım / Demirbaş" />
                <TableColumn fx:id="colAssetCategory" minWidth="90.0" prefWidth="110.0" text="Kategori" />
                <TableColumn fx:id="colAssetQuantity" minWidth="55.0" prefWidth="65.0" text="Adet" />
                <TableColumn fx:id="colAssetCondition" minWidth="90.0" prefWidth="105.0" text="Durum" />
                <TableColumn fx:id="colAssetSerial" minWidth="100.0" prefWidth="125.0" text="Seri No" />
                <TableColumn fx:id="colAssetAssignment" minWidth="140.0" prefWidth="170.0" text="Konum / Zimmet" />
                <TableColumn fx:id="colAssetPurchaseDate" minWidth="85.0" prefWidth="95.0" text="Alış Tarihi" />
                <TableColumn fx:id="colAssetPurchasePrice" minWidth="90.0" prefWidth="105.0" text="Alış Değeri" />
                <TableColumn fx:id="colAssetActions" minWidth="130.0" prefWidth="145.0" text="İşlemler" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <VBox alignment="CENTER" spacing="8.0" styleClass="empty-state">
                    <Label styleClass="empty-state-title" text="Takım veya demirbaş kaydı bulunamadı" />
                    <Label styleClass="empty-state-subtitle" text="Matkap, vakum pompası, merdiven gibi işletme varlıklarını ekleyebilirsiniz." />
                </VBox>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
