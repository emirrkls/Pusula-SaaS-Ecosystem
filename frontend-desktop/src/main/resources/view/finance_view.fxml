<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" styleClass="page-view" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.pusula.desktop.controller.FinanceController">
   <padding>
      <Insets bottom="8.0" left="0.0" right="0.0" top="8.0" />
   </padding>
   <children>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <!-- TAB 1: OPERASYON (DAILY OPERATIONS) -->
            <Tab text="%finance.tab.operations">
               <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="finance-page-scroll">
                  <content>
                     <VBox spacing="14.0" styleClass="finance-panel, finance-operation-root">
                        <padding><Insets bottom="18.0" left="16.0" right="16.0" top="16.0" /></padding>
                        <children>
                           <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="finance-command-bar">
                              <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                 <Label text="%finance.daily_operations" styleClass="section-heading" />
                                 <Label text="Günün tahsilat ve gider hareketlerini tek ekrandan yönetin." styleClass="section-caption" />
                              </VBox>
                              <Label fx:id="currentDateLabel" styleClass="date-label, finance-date-pill" />
                              <Button mnemonicParsing="false" onAction="#handleAddExpenseUnified"
                                      styleClass="btn-success" text="%unified_expense.btn.add_expense" />
                           </HBox>

                           <VBox spacing="8.0" styleClass="finance-alert-stack">
                              <HBox fx:id="overduePaymentBox" alignment="CENTER_LEFT" spacing="10.0"
                                    styleClass="finance-alert-overdue" visible="false" managed="false">
                                 <Label text="!" styleClass="finance-alert-glyph"/>
                                 <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="Geciken ödemeler" styleClass="finance-alert-title-danger" />
                                    <Label fx:id="overdueMessageLabel" styleClass="label-danger"
                                           wrapText="true" maxWidth="Infinity" />
                                 </VBox>
                                 <Button text="Ödeme ekranını aç" onAction="#handleAddExpenseUnified" styleClass="btn-danger"/>
                              </HBox>
                              <HBox fx:id="paymentAlertBox" alignment="CENTER_LEFT" spacing="10.0"
                                    styleClass="finance-alert-upcoming" visible="false" managed="false">
                                 <Label text="!" styleClass="finance-alert-glyph"/>
                                 <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="Yaklaşan ödemeler" styleClass="finance-alert-title-warning" />
                                    <Label fx:id="alertMessageLabel" styleClass="label-warning"
                                           wrapText="true" maxWidth="Infinity" />
                                 </VBox>
                                 <Button text="Ödeme ekranını aç" onAction="#handleAddExpenseUnified" styleClass="btn-warning"/>
                              </HBox>
                           </VBox>

                           <FlowPane alignment="CENTER_LEFT" hgap="12.0" vgap="12.0" styleClass="finance-summary-grid">
                              <VBox prefWidth="255.0" spacing="6.0" styleClass="finance-summary-card, finance-summary-income">
                                 <Label text="Bugünkü Gelir" styleClass="finance-summary-label" />
                                 <Label fx:id="todayIncomeLabel" styleClass="finance-summary-value, amount-positive" text="0 ₺" />
                                 <Label text="Nakit ve tahsil edilen servisler" styleClass="finance-summary-caption" />
                              </VBox>
                              <VBox prefWidth="255.0" spacing="6.0" styleClass="finance-summary-card, finance-summary-expense">
                                 <Label text="Bugünkü Gider" styleClass="finance-summary-label" />
                                 <Label fx:id="todayExpenseLabel" styleClass="finance-summary-value, amount-negative" text="0 ₺" />
                                 <Label text="Kasa çıkışları ve faaliyet giderleri" styleClass="finance-summary-caption" />
                              </VBox>
                              <VBox prefWidth="255.0" spacing="6.0" styleClass="finance-summary-card, finance-summary-net">
                                 <Label text="%finance.net_cash" styleClass="finance-summary-label" />
                                 <Label fx:id="netCashLabel" text="0 ₺" styleClass="finance-summary-value, net-cash-value" />
                                 <Label text="Günün gelir-gider farkı" styleClass="finance-summary-caption" />
                              </VBox>
                           </FlowPane>

                           <VBox spacing="3.0">
                              <Label text="Günün Hareketleri" styleClass="section-heading" />
                              <Label text="Gelir ve gider kayıtları işlem türüne göre ayrılmıştır." styleClass="section-caption" />
                           </VBox>

                           <SplitPane dividerPositions="0.5" minHeight="360.0" prefHeight="430.0" styleClass="finance-ledger-split">
                              <items>
                                 <VBox spacing="10.0" styleClass="finance-ledger-card">
                                    <Label text="%finance.todays_expense" styleClass="finance-ledger-title" />
                                    <TableView fx:id="todayExpensesTable" styleClass="premium-table, finance-ledger-table" VBox.vgrow="ALWAYS">
                                       <placeholder>
                                          <VBox alignment="CENTER" spacing="5.0" styleClass="empty-state">
                                             <Label styleClass="empty-state-title" text="Bugün gider kaydı yok" />
                                             <Label styleClass="empty-state-subtitle" text="Yeni gider eklediğinizde burada görünecek." />
                                          </VBox>
                                       </placeholder>
                                       <columns>
                                          <TableColumn fx:id="colTodayCategory" prefWidth="90.0" text="%table.category" />
                                          <TableColumn fx:id="colTodayDescription" prefWidth="120.0" text="%table.description" />
                                          <TableColumn fx:id="colTodayAmount" prefWidth="80.0" text="%table.amount" />
                                          <TableColumn fx:id="colTodayActions" text="%table.actions" prefWidth="120.0" />
                                       </columns>
                                       <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    </TableView>
                                 </VBox>
                                 <VBox spacing="10.0" styleClass="finance-ledger-card">
                                    <Label text="%finance.todays_income" styleClass="finance-ledger-title" />
                                    <TableView fx:id="todayIncomesTable" styleClass="premium-table, finance-ledger-table" VBox.vgrow="ALWAYS">
                                       <placeholder>
                                          <VBox alignment="CENTER" spacing="5.0" styleClass="empty-state">
                                             <Label styleClass="empty-state-title" text="Bugün tahsilat kaydı yok" />
                                             <Label styleClass="empty-state-subtitle" text="Tahsil edilen servisler burada görünecek." />
                                          </VBox>
                                       </placeholder>
                                       <columns>
                                          <TableColumn fx:id="colIncomeCustomer" prefWidth="120.0" text="%table.customer" />
                                          <TableColumn fx:id="colIncomeTicket" prefWidth="80.0" text="%finance.ticket_id" />
                                          <TableColumn fx:id="colIncomeAmount" prefWidth="100.0" text="%table.amount" />
                                       </columns>
                                       <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    </TableView>
                                 </VBox>
                              </items>
                           </SplitPane>

                           <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="finance-close-day-bar">
                              <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                 <Label text="Günlük mutabakat" styleClass="finance-close-day-title" />
                                 <Label text="Gelir ve giderlerin anık özetini kaydeder. Açık günler 23:59'da otomatik kapatılır." styleClass="section-caption" />
                              </VBox>
                              <Button fx:id="closeDayButton" mnemonicParsing="false" onAction="#handleCloseDay"
                                      styleClass="btn-danger, btn-close-day" text="Mutabakatı Kaydet" />
                           </HBox>
                        </children>
                     </VBox>
                  </content>
               </ScrollPane>
            </Tab>

            <!-- TAB 2: ANALİZ (ANALYTICS & CHARTS) -->
            <Tab text="%finance.tab.analytics">
               <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="finance-page-scroll">
                  <content>
                     <VBox spacing="16.0" styleClass="finance-panel, finance-analytics-root">
                        <padding><Insets bottom="20.0" left="16.0" right="16.0" top="16.0" /></padding>
                        <children>
                           <VBox spacing="3.0">
                              <Label text="Analiz ve Raporlama" styleClass="section-heading" />
                              <Label text="Son 30 günlük finansal hareketlerin sade özeti" styleClass="section-caption" />
                           </VBox>

                           <FlowPane alignment="CENTER_LEFT" hgap="12.0" vgap="12.0" styleClass="finance-analytics-kpis">
                              <VBox prefWidth="230.0" spacing="5.0" styleClass="analytics-kpi-card">
                                 <Label text="30 Günlük Gelir" styleClass="finance-summary-label" />
                                 <Label fx:id="analyticsIncomeLabel" text="0 ₺" styleClass="analytics-kpi-value, amount-positive" />
                              </VBox>
                              <VBox prefWidth="230.0" spacing="5.0" styleClass="analytics-kpi-card">
                                 <Label text="30 Günlük Gider" styleClass="finance-summary-label" />
                                 <Label fx:id="analyticsExpenseLabel" text="0 ₺" styleClass="analytics-kpi-value, amount-negative" />
                              </VBox>
                              <VBox prefWidth="230.0" spacing="5.0" styleClass="analytics-kpi-card">
                                 <Label text="30 Günlük Net" styleClass="finance-summary-label" />
                                 <Label fx:id="analyticsNetLabel" text="0 ₺" styleClass="analytics-kpi-value" />
                              </VBox>
                              <VBox prefWidth="230.0" spacing="5.0" styleClass="analytics-kpi-card">
                                 <Label text="En Yüksek Gider" styleClass="finance-summary-label" />
                                 <Label fx:id="analyticsTopCategoryLabel" text="—" wrapText="true" styleClass="analytics-kpi-value-small" />
                              </VBox>
                           </FlowPane>

                           <VBox spacing="8.0" prefHeight="350.0" styleClass="analytics-card">
                              <Label text="%finance.income_expense_trend" styleClass="finance-ledger-title" />
                              <Label text="Günlük gelir ve gider karşılaştırması" styleClass="section-caption" />
                              <LineChart fx:id="trendChart" animated="false" createSymbols="false"
                                         legendVisible="true" prefHeight="285.0" VBox.vgrow="ALWAYS"
                                         styleClass="finance-trend-chart">
                                 <xAxis><javafx.scene.chart.CategoryAxis label="%chart.date" styleClass="chart-axis-modern" /></xAxis>
                                 <yAxis><NumberAxis label="%chart.amount_tl" minorTickVisible="false" styleClass="chart-axis-modern" /></yAxis>
                              </LineChart>
                           </VBox>

                           <VBox spacing="8.0" prefHeight="330.0" styleClass="analytics-card">
                              <Label text="%finance.expense_distribution" styleClass="finance-ledger-title" />
                              <Label text="Bu ayın giderlerinin kategori bazında dağılımı" styleClass="section-caption" />
                              <StackPane VBox.vgrow="ALWAYS">
                                 <PieChart fx:id="expensePieChart" animated="false" legendVisible="true" prefHeight="260.0"
                                           styleClass="finance-expense-pie" />
                                 <VBox fx:id="expenseCategoryStateBox" alignment="CENTER" managed="false" spacing="7.0"
                                       styleClass="analytics-single-state" visible="false">
                                    <Label fx:id="expenseCategoryStateTitle" styleClass="analytics-single-title" text="Bu ay gider kaydı yok" />
                                    <Label fx:id="expenseCategoryStateAmount" styleClass="analytics-single-value" text="0 ₺" />
                                    <Label fx:id="expenseCategoryStateCaption" styleClass="section-caption" text="Kategori dağılımı kayıt oluştukça burada görünür." />
                                 </VBox>
                              </StackPane>
                           </VBox>
                        </children>
                     </VBox>
                  </content>
               </ScrollPane>
            </Tab>

            <!-- TAB 3: RAPORLAR (REPORTS - PLACEHOLDER) -->
            <Tab text="%finance.tab.reports">
               <VBox spacing="16.0" styleClass="finance-panel, finance-reports-root">
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  <children>
                     <VBox spacing="3.0">
                        <Label text="Aylık Finansal Raporlar" styleClass="page-header-title" />
                        <Label text="Seçili ayın faaliyet sonucunu özet kartlardan, geçmiş dönemleri arşiv tablosundan inceleyin." styleClass="section-caption" />
                     </VBox>

                     <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="290.0" styleClass="report-summary-scroll">
                        <content>
                           <VBox fx:id="reportDetailContainer" spacing="12.0" styleClass="report-detail-panel" />
                        </content>
                     </ScrollPane>

                     <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <Label text="Dönem Arşivi" styleClass="section-title" />
                           <Label text="Bir dönem seçtiğinizde üstteki özet yenilenir." styleClass="section-caption" />
                        </VBox>
                     </HBox>

                        <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS" styleClass="premium-table, report-archive-table">
                         <placeholder><Label styleClass="empty-state" text="Henüz aylık rapor oluşmadı." /></placeholder>
                         <columns>
                            <TableColumn fx:id="colReportPeriod" text="%reports.period" prefWidth="150.0" />
                            <TableColumn fx:id="colReportIncome" text="Satış / Ciro" prefWidth="115.0" />
                            <TableColumn fx:id="colReportCurrentAccount" text="Cariye Aktarılan" prefWidth="130.0" />
                            <TableColumn fx:id="colReportExpense" text="Toplam Kârlılık Gideri" prefWidth="145.0" />
                            <TableColumn fx:id="colReportProfit" text="Aylık Kâr / Zarar" prefWidth="125.0" />
                            <TableColumn fx:id="colReportClosingProfit" text="Dönem Sonu Birikimli K/Z" prefWidth="155.0" />
                            <TableColumn fx:id="colReportCarryOver" text="Geçmiş Birikimli K/Z" prefWidth="145.0" visible="false" />
                            <TableColumn fx:id="colReportActions" text="%table.actions" prefWidth="100.0" />
                         </columns>
                         <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                         </columnResizePolicy>
                        </TableView>
                  </children>
               </VBox>
            </Tab>
            
            <!-- TAB 4: CARİ HESAPLAR (CURRENT ACCOUNTS) -->
            <Tab text="%finance.tab.current_accounts">
               <VBox spacing="15.0" styleClass="finance-panel">
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  <children>
                     <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="%finance.tab.current_accounts" styleClass="section-title">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleManageAccountParties" styleClass="btn-secondary" text="Kurum/Firma Kartları" />
                        <Button onAction="#handleExportCurrentAccountsPdf" styleClass="btn-export" text="PDF Kaydet" />
                     </HBox>
                     
                     <Separator />
                     
                     <TableView fx:id="currentAccountsTable" styleClass="premium-table" VBox.vgrow="ALWAYS">
                        <placeholder><Label styleClass="empty-state" text="Açık cari hesap bulunmuyor." /></placeholder>
                        <columns>
                           <TableColumn fx:id="colAccountCustomer" text="%current_account.customer" prefWidth="200.0" />
                           <TableColumn fx:id="colAccountBalance" text="%current_account.balance" prefWidth="150.0" />
                           <TableColumn fx:id="colAccountLastUpdated" text="%current_account.last_updated" prefWidth="180.0" />
                           <TableColumn fx:id="colAccountActions" text="%table.actions" prefWidth="210.0" />
                        </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                     </TableView>
                  </children>
               </VBox>
            </Tab>
            
            <!-- TAB 5: BORÇLARIMIZ (OUR DEBTS) -->
            <Tab text="Borçlarımız">
               <fx:include source="company_debts.fxml"/>
            </Tab>
            
            <!-- TAB 6: İŞLETME MÜLKİYETİ (BUSINESS ASSETS) -->
            <Tab text="%finance.tab.assets">
               <ScrollPane fitToWidth="true" styleClass="finance-scroll-pane">
                  <content>
                     <VBox spacing="20.0" styleClass="finance-ownership-root">
                        <padding>
                           <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                        </padding>
                        <children>
                           <VBox spacing="6.0">
                              <Label styleClass="section-title" text="%finance.tab.assets" />
                              <Label styleClass="label-muted" text="%finance.assets.subtitle" wrapText="true" />
                           </VBox>

                           <VBox spacing="8.0" styleClass="finance-ownership-hero card-container">
                              <Label styleClass="finance-ownership-hero-label" text="%finance.assets.total_equity" />
                              <Label fx:id="assetTotalEquityLabel" styleClass="finance-ownership-hero-value" text="₺0,00" />
                              <Label styleClass="label-muted finance-ownership-formula" text="%finance.assets.formula" wrapText="true" />
                           </VBox>

                           <HBox spacing="16.0">
                              <VBox spacing="8.0" styleClass="finance-ownership-metric card-container" HBox.hgrow="ALWAYS">
                                 <Label styleClass="finance-ownership-metric-label" text="%finance.card.inventory_value" wrapText="true" />
                                 <Label fx:id="assetInventoryValueLabel" styleClass="finance-ownership-metric-value finance-value-positive" text="₺0,00" />
                                 <Label styleClass="label-muted finance-ownership-metric-hint" text="%finance.assets.inventory_hint" wrapText="true" />
                              </VBox>
                              <VBox spacing="8.0" styleClass="finance-ownership-metric card-container" HBox.hgrow="ALWAYS">
                                 <Label styleClass="finance-ownership-metric-label" text="%finance.card.net_cash" wrapText="true" />
                                 <Label fx:id="assetNetCashLabel" styleClass="finance-ownership-metric-value" text="₺0,00" />
                                 <Label styleClass="label-muted finance-ownership-metric-hint" text="%finance.assets.cash_hint" wrapText="true" />
                              </VBox>
                           </HBox>

                           <VBox spacing="12.0" styleClass="card-container finance-ownership-breakdown">
                              <Label styleClass="card-title" text="%finance.assets.breakdown_title" />
                              <VBox spacing="10.0" styleClass="finance-ownership-breakdown-list">
                                 <HBox styleClass="finance-ownership-row">
                                    <Label styleClass="finance-ownership-row-label" text="%finance.assets.row.inventory" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="assetBreakdownInventoryLabel" styleClass="finance-ownership-row-value" text="₺0,00" />
                                 </HBox>
                                 <HBox styleClass="finance-ownership-row">
                                    <Label styleClass="finance-ownership-row-label" text="%finance.assets.row.income" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="assetBreakdownIncomeLabel" styleClass="finance-ownership-row-value finance-value-positive" text="₺0,00" />
                                 </HBox>
                                 <HBox styleClass="finance-ownership-row">
                                    <Label styleClass="finance-ownership-row-label" text="%finance.assets.row.expenses" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="assetBreakdownExpensesLabel" styleClass="finance-ownership-row-value finance-value-negative" text="₺0,00" />
                                 </HBox>
                                 <HBox styleClass="finance-ownership-row finance-ownership-row-subtotal">
                                    <Label styleClass="finance-ownership-row-label" text="%finance.assets.row.net_cash" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="assetBreakdownNetCashLabel" styleClass="finance-ownership-row-value" text="₺0,00" />
                                 </HBox>
                                 <Region styleClass="finance-ownership-divider" />
                                 <HBox styleClass="finance-ownership-row finance-ownership-row-total">
                                    <Label styleClass="finance-ownership-row-label finance-ownership-row-label-strong" text="%finance.assets.row.total" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="assetBreakdownTotalLabel" styleClass="finance-ownership-row-value finance-ownership-row-value-strong" text="₺0,00" />
                                 </HBox>
                              </VBox>
                           </VBox>
                        </children>
                     </VBox>
                  </content>
               </ScrollPane>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</VBox>
