<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pusula.desktop.controller.CompanyDebtController"
      spacing="16" styleClass="subsection-panel, debt-workspace">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="10" styleClass="page-header">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label styleClass="page-header-title" text="Borç Yönetimi"/>
                <Label styleClass="section-caption" text="Tedarikçi bakiyelerini tek karttan izleyin; alım ve ödemeleri hareket geçmişinde yönetin."/>
            </VBox>
        </HBox>
        <FlowPane alignment="CENTER_RIGHT" hgap="10" vgap="8" styleClass="page-header-actions">
            <Button onAction="#handleExportPdf" styleClass="btn-export" text="PDF Kaydet"/>
            <Button onAction="#handleAddDebt" styleClass="btn-primary" text="+ Borç Ekle"/>
            <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Yenile"/>
        </FlowPane>
    </VBox>

    <FlowPane hgap="12" vgap="12" styleClass="debt-summary-strip">
        <VBox prefWidth="240" spacing="5" styleClass="debt-summary-card, debt-summary-total">
            <Label styleClass="finance-summary-label" text="Açık Toplam Borç"/>
            <Label fx:id="totalDebtLabel" styleClass="debt-summary-value, amount-negative" text="0 ₺"/>
            <Label styleClass="finance-summary-caption" text="Henüz ödenmemiş toplam bakiye"/>
        </VBox>
        <VBox prefWidth="210" spacing="5" styleClass="debt-summary-card">
            <Label styleClass="finance-summary-label" text="Aktif Tedarikçi"/>
            <Label fx:id="activeSupplierCountLabel" styleClass="debt-summary-value" text="0"/>
            <Label styleClass="finance-summary-caption" text="Bakiyesi bulunan kart sayısı"/>
        </VBox>
        <VBox prefWidth="210" spacing="5" styleClass="debt-summary-card">
            <Label styleClass="finance-summary-label" text="Açık Alım"/>
            <Label fx:id="openDebtCountLabel" styleClass="debt-summary-value" text="0"/>
            <Label styleClass="finance-summary-caption" text="Açık veya kısmi ödenmiş hareket"/>
        </VBox>
    </FlowPane>

    <FlowPane alignment="CENTER_LEFT" hgap="10" vgap="8" styleClass="filter-bar">
        <TextField fx:id="partySearchField" prefWidth="280" promptText="Tedarikçi veya alacaklı ara"/>
        <ComboBox fx:id="statusFilter" prefWidth="180" promptText="Borcu Olanlar"/>
        <Button onAction="#applyFilter" styleClass="btn-primary" text="Filtrele"/>
        <Button onAction="#clearFilters" styleClass="btn-secondary" text="Temizle"/>
    </FlowPane>

    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="debt-table-card">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label styleClass="section-title" text="Tedarikçi Kartları"/>
                    <Label styleClass="section-caption" text="Bir karta çift tıklayarak ayrıntılı hareketleri açabilirsiniz."/>
                </VBox>
            </HBox>
            <TableView fx:id="partyTable" styleClass="premium-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPartyName" minWidth="180" text="Tedarikçi / Alacaklı"/>
                    <TableColumn fx:id="colPartyPurchases" minWidth="120" text="Toplam Alım"/>
                    <TableColumn fx:id="colPartyPaid" minWidth="120" text="Toplam Ödeme"/>
                    <TableColumn fx:id="colPartyBalance" minWidth="120" text="Kalan Borç"/>
                    <TableColumn fx:id="colPartyFirstDate" minWidth="105" text="Başlangıç"/>
                    <TableColumn fx:id="colPartyLastDate" minWidth="105" text="Son Hareket"/>
                    <TableColumn fx:id="colPartyActions" minWidth="220" text="İşlemler"/>
                </columns>
                <placeholder><Label text="Henüz tedarikçi kartı bulunmuyor"/></placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
    </VBox>

    <TitledPane fx:id="debtDetailPane" animated="false" expanded="false" text="Hareket geçmişi">
        <content>
        <VBox spacing="8" styleClass="debt-detail-content">
            <Label fx:id="debtDetailLabel" styleClass="section-title" text="Bir tedarikçi kartı seçin"/>
            <TableView fx:id="debtTable" prefHeight="270" styleClass="premium-table">
                <columns>
                    <TableColumn fx:id="colCreditor" minWidth="130" text="Alacaklı"/>
                    <TableColumn fx:id="colCategory" minWidth="90" text="Kategori"/>
                    <TableColumn fx:id="colDescription" minWidth="150" text="Açıklama"/>
                    <TableColumn fx:id="colOriginal" minWidth="105" text="Toplam Borç"/>
                    <TableColumn fx:id="colRemaining" minWidth="105" text="Kalan Borç"/>
                    <TableColumn fx:id="colDebtDate" minWidth="90" text="Borç Tarihi"/>
                    <TableColumn fx:id="colDueDate" minWidth="90" text="Vade Tarihi"/>
                    <TableColumn fx:id="colStatus" minWidth="80" text="Durum"/>
                    <TableColumn fx:id="colActions" minWidth="175" text="İşlemler"/>
                </columns>
                <placeholder><Label text="Kartı seçerek alım ve ödeme hareketlerini görüntüleyin"/></placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
        </content>
    </TitledPane>
</VBox>
