<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pusula.desktop.controller.CompanyDebtController"
      spacing="15" styleClass="subsection-panel">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="10" styleClass="page-header">
        <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="page-header-title" text="Tedarikçi ve Borç Kartları" HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalDebtLabel" styleClass="debt-total-label" text="Toplam Borç: 0 ₺"/>
        </HBox>
        <FlowPane alignment="CENTER_RIGHT" hgap="10" vgap="8" styleClass="page-header-actions">
            <Button onAction="#handleExportPdf" styleClass="btn-export" text="PDF Kaydet"/>
            <Button onAction="#handleAddDebt" styleClass="btn-primary" text="+ Borç Ekle"/>
            <Button onAction="#loadDebts" styleClass="btn-secondary" text="Yenile"/>
        </FlowPane>
    </VBox>

    <FlowPane alignment="CENTER_LEFT" hgap="10" vgap="8" styleClass="filter-bar">
        <Label text="Filtre:"/>
        <ComboBox fx:id="statusFilter" prefWidth="150" promptText="Tümü"/>
        <Button onAction="#applyFilter" styleClass="btn-primary" text="Uygula"/>
    </FlowPane>

    <SplitPane orientation="VERTICAL" VBox.vgrow="ALWAYS" dividerPositions="0.43">
        <VBox spacing="6">
            <Label styleClass="section-title" text="Tedarikçi Kartları"/>
            <TableView fx:id="partyTable" styleClass="premium-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPartyName" minWidth="180" text="Tedarikçi / Alacaklı"/>
                    <TableColumn fx:id="colPartyPurchases" minWidth="120" text="Toplam Alım"/>
                    <TableColumn fx:id="colPartyPaid" minWidth="120" text="Toplam Ödeme"/>
                    <TableColumn fx:id="colPartyBalance" minWidth="120" text="Kalan Borç"/>
                    <TableColumn fx:id="colPartyFirstDate" minWidth="105" text="Başlangıç"/>
                    <TableColumn fx:id="colPartyLastDate" minWidth="105" text="Son Hareket"/>
                    <TableColumn fx:id="colPartyActions" minWidth="235" text="İşlemler"/>
                </columns>
                <placeholder><Label text="Henüz tedarikçi kartı bulunmuyor"/></placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
        <VBox spacing="6">
            <Label fx:id="debtDetailLabel" styleClass="section-title" text="Tüm Borç Hareketleri"/>
            <TableView fx:id="debtTable" styleClass="premium-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCreditor" minWidth="130" text="Alacaklı"/>
                    <TableColumn fx:id="colCategory" minWidth="90" text="Kategori"/>
                    <TableColumn fx:id="colDescription" minWidth="150" text="Açıklama"/>
                    <TableColumn fx:id="colOriginal" minWidth="105" text="Toplam Borç"/>
                    <TableColumn fx:id="colRemaining" minWidth="105" text="Kalan Borç"/>
                    <TableColumn fx:id="colDebtDate" minWidth="90" text="Borç Tarihi"/>
                    <TableColumn fx:id="colDueDate" minWidth="90" text="Vade Tarihi"/>
                    <TableColumn fx:id="colStatus" minWidth="80" text="Durum"/>
                    <TableColumn fx:id="colActions" minWidth="175" text="İşlemler"/>
                </columns>
                <placeholder><Label text="Kartı seçerek alım ve ödeme hareketlerini görüntüleyin"/></placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>
