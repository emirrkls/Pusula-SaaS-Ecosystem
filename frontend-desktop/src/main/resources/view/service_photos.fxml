<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="rootPane" spacing="14" styleClass="page-view"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pusula.desktop.controller.ServicePhotosController">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="service-photo-toolbar">
        <TextField fx:id="searchField" promptText="Müşteri, iş başlığı, fiş no veya not ara" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryFilter" prefWidth="190"/>
        <DatePicker fx:id="startDatePicker" promptText="Başlangıç"/>
        <DatePicker fx:id="endDatePicker" promptText="Bitiş"/>
        <Button text="Filtrele" onAction="#loadPhotos" styleClass="btn-primary"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <ScrollPane fx:id="folderScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="service-photo-scroll">
            <content>
                <VBox spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Servis Dosyaları" styleClass="section-heading"/>
                            <Label fx:id="archiveSummaryLabel" text="Müşteri ve iş emrine göre gruplanmış görsel arşivi" styleClass="section-caption"/>
                        </VBox>
                    </HBox>
                    <FlowPane fx:id="folderFlow" hgap="14" vgap="14" prefWrapLength="1050"/>
                    <Label fx:id="emptyArchiveLabel" text="Filtrelere uygun servis görseli bulunamadı."
                           visible="false" managed="false" styleClass="service-photo-empty"/>
                </VBox>
            </content>
        </ScrollPane>

        <VBox fx:id="galleryPane" spacing="12" visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="service-gallery-header">
                <Button text="← Servis Dosyaları" onAction="#showArchive"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="galleryTitleLabel" styleClass="service-gallery-title"/>
                    <Label fx:id="galleryMetaLabel" styleClass="section-caption"/>
                </VBox>
            </HBox>
            <ScrollPane fx:id="galleryScroll" fitToWidth="true" hbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS" styleClass="service-photo-scroll">
                <content>
                    <FlowPane fx:id="galleryFlow" hgap="14" vgap="14" prefWrapLength="1050"/>
                </content>
            </ScrollPane>
        </VBox>

        <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false" maxWidth="48" maxHeight="48"/>
    </StackPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="Servis dosyası seçerek içindeki görselleri görüntüleyebilirsiniz."
               styleClass="section-caption"/>
    </HBox>
</VBox>
