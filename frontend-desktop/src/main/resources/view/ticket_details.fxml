<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="16.0" styleClass="dialog-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pusula.desktop.controller.TicketDetailsController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="detail-header">
         <children>
            <Label styleClass="dialog-title" text="%ticket.details.title" />
            <Label fx:id="lblStatus" styleClass="page-subtitle" text="STATUS" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnChangeStatus" mnemonicParsing="false" onAction="#handleChangeStatus" styleClass="btn-primary" text="%ticket.change.status" visible="false" managed="false"/>
         </children>
      </HBox>
      
      <!-- Parent Ticket Link -->
      <Label fx:id="lblParentLink" managed="false" styleClass="link-label" text="" underline="true" visible="false" />
      
      <!-- Customer Information Card -->
      <VBox spacing="8.0" styleClass="ticket-details-panel">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label styleClass="section-title" text="%ticket.customer_info" />
            <FlowPane hgap="32.0" vgap="12.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="field-label" text="%customer.name" />
                        <Label fx:id="lblCustomerName" styleClass="field-value" text="-" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="field-label" text="%ticket.customer_phone" />
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label fx:id="lblCustomerPhone" styleClass="field-value" text="-" />
                              <Button fx:id="btnWhatsApp" mnemonicParsing="false" onAction="#handleWhatsAppClick" styleClass="btn-whatsapp-icon" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefWidth="320.0" spacing="5.0">
                     <children>
                        <Label styleClass="field-label" text="%ticket.customer_address" />
                        <Label fx:id="lblCustomerAddress" styleClass="field-value" text="-" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </FlowPane>
         </children>
      </VBox>

      <FlowPane fx:id="financialSummary" managed="false" hgap="12.0" vgap="10.0" styleClass="ticket-financial-summary" visible="false">
         <children>
            <VBox styleClass="ticket-summary-card"><Label styleClass="field-label" text="Fiş Toplamı"/><Label fx:id="lblInvoiceTotal" styleClass="ticket-summary-value"/></VBox>
            <VBox styleClass="ticket-summary-card"><Label styleClass="field-label" text="Tahsil Edilen"/><Label fx:id="lblCollectedAmount" styleClass="ticket-summary-value-success"/></VBox>
            <VBox styleClass="ticket-summary-card"><Label styleClass="field-label" text="Cariye Aktarılan"/><Label fx:id="lblOutstandingAmount" styleClass="ticket-summary-value-warning"/></VBox>
            <VBox styleClass="ticket-summary-card"><Label styleClass="field-label" text="Ödeme Yöntemi"/><Label fx:id="lblPaymentMethod" styleClass="ticket-summary-value"/></VBox>
            <VBox styleClass="ticket-summary-card"><Label styleClass="field-label" text="Kapanış Tarihi"/><Label fx:id="lblCompletionDate" styleClass="ticket-summary-value"/></VBox>
         </children>
      </FlowPane>
      
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab text="%ticket.tab.details">
               <content>
                  <ScrollPane fitToWidth="true" styleClass="scroll-pane-transparent">
                     <content>
                        <VBox spacing="15.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="15.0" />
                           </padding>
                           <children>
                              <FlowPane hgap="20.0" prefWrapLength="760.0" vgap="16.0">
                                 <children>
                                    <VBox prefWidth="430.0" spacing="10.0">
                                       <children>
                                          <Label styleClass="muted-label" text="%ticket.description" />
                                          <TextArea fx:id="txtDescription" editable="false" prefHeight="70.0" wrapText="true" />
                                          <Label styleClass="muted-label" text="%ticket.notes" />
                                          <TextArea fx:id="txtNotes" prefHeight="70.0" wrapText="true" />
                                          <Button fx:id="btnSaveNotes" mnemonicParsing="false" onAction="#handleSaveNotes" styleClass="btn-secondary" text="%ticket.save.notes" />
                                          <VBox fx:id="technicianPrivateNoteBox" managed="false" spacing="5.0" styleClass="ticket-details-panel" visible="false">
                                             <children>
                                                <Label styleClass="section-heading" text="Teknisyene Özel Not" />
                                                <TextArea fx:id="txtTechnicianPrivateNote" editable="false" prefHeight="72.0" wrapText="true" />
                                                <Label styleClass="muted-label" text="Müşteri formunda ve PDF'de gösterilmez." wrapText="true" />
                                             </children>
                                          </VBox>
                                          <VBox fx:id="workProgressBox" managed="false" spacing="5.0" styleClass="ticket-details-panel" visible="false">
                                             <children>
                                                <Label fx:id="lblWorkProgressReason" styleClass="section-heading" wrapText="true" />
                                                <Label fx:id="lblWorkProgressNote" styleClass="muted-label" wrapText="true" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                    
                                    <VBox prefWidth="280.0" spacing="10.0">
                                       <children>
                                          <Label styleClass="muted-label" text="%ticket.assign.technician" />
                                          <DatePicker fx:id="assignmentDatePicker" maxWidth="1.7976931348623157E308" />
                                          <HBox spacing="8.0">
                                             <children>
                                                <ComboBox fx:id="assignmentStartTime" promptText="Başlangıç" HBox.hgrow="ALWAYS" />
                                                <ComboBox fx:id="assignmentEndTime" promptText="Bitiş" HBox.hgrow="ALWAYS" />
                                             </children>
                                          </HBox>
                                          <HBox spacing="10.0">
                                             <children>
                                                <ComboBox fx:id="comboTechnician" prefWidth="180.0" promptText="%ticket.select.technician" />
                                                <Button fx:id="btnAssign" minWidth="70.0" mnemonicParsing="false" onAction="#handleAssign" prefWidth="80.0" styleClass="btn-primary" text="%btn.assign" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </FlowPane>
                              
                              <VBox spacing="10.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label styleClass="section-heading" text="%ticket.used.parts" />
                                          <Button fx:id="btnAddPart" mnemonicParsing="false" onAction="#handleAddPart" styleClass="btn-success" text="%ticket.add.part" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="partsTable" minHeight="100.0" prefHeight="120.0" styleClass="premium-table bordered-table">
                                       <columns>
                                          <TableColumn fx:id="colPartName" prefWidth="250.0" text="%ticket.part.name" />
                                          <TableColumn fx:id="colQuantity" prefWidth="80.0" text="%ticket.quantity" />
                                          <TableColumn fx:id="colPrice" prefWidth="100.0" text="%ticket.price" />
                                          <TableColumn fx:id="colPartActions" minWidth="150.0" prefWidth="165.0" text="İşlemler" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                              
                              <!-- External Expenses Section -->
                              <VBox spacing="10.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label styleClass="section-heading" text="Dış Giderler" />
                                          <Button fx:id="btnAddExpense" mnemonicParsing="false" onAction="#handleAddExpense" styleClass="btn-warning" text="+ Dış Gider Ekle" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="expensesTable" minHeight="100.0" prefHeight="120.0" styleClass="premium-table bordered-table">
                                       <columns>
                                          <TableColumn fx:id="colExpenseDescription" prefWidth="200.0" text="Açıklama" />
                                          <TableColumn fx:id="colExpenseSupplier" prefWidth="150.0" text="Tedarikçi" />
                                          <TableColumn fx:id="colExpenseAmount" prefWidth="100.0" text="Tutar" />
                                          <TableColumn fx:id="colExpenseActions" minWidth="110.0" prefWidth="125.0" text="İşlemler" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
            <Tab text="%ticket.tab.history">
               <content>
                  <ScrollPane fitToWidth="true" styleClass="scroll-pane-transparent">
                     <content>
                        <VBox fx:id="timelineContainer" spacing="15.0" styleClass="timeline-container">
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
      
      <VBox spacing="8.0" styleClass="ticket-action-bar">
         <children>
            <FlowPane alignment="CENTER_LEFT" hgap="10.0" vgap="8.0">
               <children>
                  <Button fx:id="btnPrintPdf" onAction="#handlePrintPdf" styleClass="btn-secondary" text="%btn.print" />
                  <Button fx:id="btnCreateRecall" managed="false" onAction="#handleCreateRecall" styleClass="btn-warning" text="%ticket.recall" visible="false" />
                  <Button fx:id="btnEditCompleted" managed="false" onAction="#handleEditCompleted" styleClass="btn-secondary" text="%btn.edit_completed" visible="false" />
               </children>
            </FlowPane>
            <FlowPane alignment="CENTER_RIGHT" hgap="10.0" vgap="8.0">
               <children>
                  <Button fx:id="btnCancelService" mnemonicParsing="false" onAction="#handleCancelService" styleClass="btn-danger" text="%ticket.cancel" />
                  <Button fx:id="btnCompleteService" mnemonicParsing="false" onAction="#handleCompleteService" styleClass="btn-success" text="%ticket.complete" />
               </children>
            </FlowPane>
         </children>
      </VBox>
   </children>
</VBox>
