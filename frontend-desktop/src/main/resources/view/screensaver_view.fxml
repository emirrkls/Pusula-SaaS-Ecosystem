<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pusula.desktop.controller.ScreensaverController"
           fx:id="rootPane" styleClass="screensaver-root">
    
    <!-- Vignette Effect for depth -->
    <Region styleClass="screensaver-vignette"
            mouseTransparent="true"/>
    
    <!-- Particle Layer (behind logo) -->
    <Pane fx:id="particlePane" mouseTransparent="true"/>
    
    <!-- Rotating Logo container for centering -->
    <StackPane>
        <!-- Outer Glow Ring (Stationary) -->
        <Circle radius="210" fill="transparent" stroke="#00bfff" strokeWidth="3" opacity="0.1" strokeType="OUTSIDE">
             <effect>
                <GaussianBlur radius="30"/>
             </effect>
        </Circle>
        
        <!-- Rotating Logo -->
        <ImageView fx:id="logoImage" fitWidth="350" fitHeight="350" preserveRatio="true">
            <image>
                <Image url="@../transparentLogo.png"/>
            </image>
            <effect>
                <DropShadow color="#00bfff" radius="60" spread="0.2">
                    <input>
                        <Glow level="0.7"/>
                    </input>
                </DropShadow>
            </effect>
        </ImageView>
    </StackPane>
    
    <!-- Text Container -->
    <VBox alignment="CENTER" spacing="10" StackPane.alignment="BOTTOM_CENTER" translateY="-80">
        <Label styleClass="screensaver-title" text="PUSULA SERVİS YÖNETİMİ"/>
               
        <Label styleClass="screensaver-status" text="Güvenli oturum etkin"/>
    </VBox>
    
    <!-- Hint text -->
    <Label styleClass="screensaver-hint"
           text="Devam etmek için ekrana tıklayın veya bir tuşa basın"
           StackPane.alignment="BOTTOM_CENTER" translateY="-20"/>
</StackPane>
