<?xml version="1.0" encoding="UTF-8"?>

<?import com.pusula.desktop.util.CurrencyTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14.0" styleClass="dialog-root" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pusula.desktop.controller.BusinessAssetDialogController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
    <Label fx:id="titleLabel" styleClass="dialog-title" text="Takım / Demirbaş Ekle" />

    <GridPane hgap="14" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
        </columnConstraints>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label styleClass="field-label" text="Ad *" />
            <TextField fx:id="nameField" promptText="Örn. Vakum pompası" />
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label styleClass="field-label" text="Kategori" />
            <TextField fx:id="categoryField" promptText="Örn. Elektrikli El Aleti" />
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label styleClass="field-label" text="Adet *" />
            <TextField fx:id="quantityField" promptText="1" />
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label styleClass="field-label" text="Durum" />
            <ComboBox fx:id="conditionCombo" maxWidth="Infinity" />
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label styleClass="field-label" text="Seri Numarası" />
            <TextField fx:id="serialNumberField" />
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label styleClass="field-label" text="Konum" />
            <TextField fx:id="locationField" promptText="Örn. Depo, Servis Aracı" />
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label styleClass="field-label" text="Zimmetli Kişi" />
            <TextField fx:id="assignedToField" />
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label styleClass="field-label" text="Alış Tarihi" />
            <DatePicker fx:id="purchaseDatePicker" maxWidth="Infinity" />
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <Label styleClass="field-label" text="Alış Değeri" />
            <CurrencyTextField fx:id="purchasePriceField" promptText="0,00" />
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
            <Label styleClass="field-label" text="Not" />
            <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true" />
        </VBox>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="dialog-action-bar">
        <Button onAction="#handleCancel" styleClass="btn-secondary" text="İptal" />
        <Button defaultButton="true" onAction="#handleSave" styleClass="btn-success" text="Kaydet" />
    </HBox>
</VBox>
