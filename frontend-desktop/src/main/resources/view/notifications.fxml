<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pusula.desktop.controller.NotificationsController">
  <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="notification-toolbar">
    <VBox spacing="3"><Label text="Bildirim Merkezi" styleClass="section-title"/><Label fx:id="summaryLabel" text="Yükleniyor..." styleClass="page-subtitle"/></VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="markAllButton" text="Tümünü Okundu Yap" onAction="#markAllRead" styleClass="button-secondary"/>
  </HBox>
  <ScrollPane fitToWidth="true" styleClass="service-photo-scroll" VBox.vgrow="ALWAYS">
    <content><VBox fx:id="notificationList" spacing="10"/></content>
  </ScrollPane>
  <Label fx:id="emptyLabel" text="Henüz bildirim yok." visible="false" managed="false" styleClass="service-photo-empty"/>
</VBox>
