<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="com.pusula.desktop.controller.BulkAssignTicketsDialogController"
      minHeight="520" minWidth="620" prefHeight="620" prefWidth="720" spacing="16"
      styleClass="dialog-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="20" left="22" right="22" top="20"/></padding>

    <VBox spacing="5">
        <Label styleClass="dialog-title" text="Toplu Atama"/>
        <Label styleClass="page-subtitle" text="Atama bekleyen servis fişlerini seçip tek seferde bir teknisyene aktarın."/>
    </VBox>

    <VBox spacing="7">
        <Label styleClass="field-label" text="Teknisyen"/>
        <ComboBox fx:id="technicianCombo" maxWidth="Infinity" promptText="Teknisyen seçiniz" styleClass="form-control-tall"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <CheckBox fx:id="selectAllCheckBox" onAction="#handleSelectAll" text="Tümünü seç"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="selectionLabel" styleClass="bulk-selection-count" text="Henüz fiş seçilmedi"/>
    </HBox>

    <ListView fx:id="ticketList" styleClass="bulk-ticket-list" VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="dialog-action-bar">
        <Button onAction="#handleCancel" styleClass="btn-secondary" text="İptal"/>
        <Button fx:id="assignButton" disable="true" onAction="#handleAssign" styleClass="btn-primary" text="Fişleri Ata"/>
    </HBox>
</VBox>
